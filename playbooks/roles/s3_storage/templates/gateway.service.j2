[Unit]
Description=MongoDB DR S3 storage
Requires=wg-quick@wg0.service
After=wg-quick@wg0.service

[Service]
User=mongo-dr-s3
Group=mongo-dr-s3
EnvironmentFile=/etc/mongo-dr-s3.env
ExecStart=/opt/mongo-dr-s3/{{ dr_s3_version }}/versitygw --port {{ wg_ip }}:{{ dr_s3_port }} --iam-dir {{ dr_s3_home }}/iam posix {{ dr_s3_home }}/objects
Restart=on-failure
RestartSec=3
UMask=0077

[Install]
WantedBy=multi-user.target

storage:
  type: s3
  s3:
    endpointUrl: {{ dr_s3_endpoint }}
    region: {{ dr_s3_region }}
    bucket: {{ dr_s3_bucket }}
    prefix: {{ dr_s3_prefix }}
    forcePathStyle: true
    credentials:
      access-key-id: {{ dr_s3_access | to_json }}
      secret-access-key: {{ dr_s3_secret | to_json }}
pitr:
  enabled: {{ ('source' in group_names) | lower }}
  oplogSpanMin: {{ dr_slice_minutes }}
  compression: s2

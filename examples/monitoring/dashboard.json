{
  "uid": "mongodb-dr",
  "title": "MongoDB backup and recovery",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "MongoDB source",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "mongo-dr-prometheus"
      },
      "targets": [
        {
          "expr": "mongo_dr_mongodb_up{role=\"source\"}",
          "refId": "A",
          "legendFormat": "{{host}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "title": "S3 authenticated access",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "mongo-dr-prometheus"
      },
      "targets": [
        {
          "expr": "mongo_dr_s3_up{role=\"source\"}",
          "refId": "A",
          "legendFormat": "{{host}}"
        }
      ],
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "title": "PITR age",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "mongo-dr-prometheus"
      },
      "targets": [
        {
          "expr": "time() - mongo_dr_latest_restore_point_timestamp_seconds{role=\"source\"}",
          "refId": "A",
          "legendFormat": "{{host}}"
        }
      ],
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false

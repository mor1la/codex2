[Unit]
Description=MongoDB DR daily snapshot and retention
Wants=mongo-dr-pbm.service
After=mongo-dr-pbm.service

[Service]
Type=oneshot
User=mongo-dr
EnvironmentFile={{ dr_home }}/pbm.env
ExecStart=/usr/bin/pbm backup --type=logical --compression=s2 --wait
ExecStart=/usr/bin/pbm cleanup --older-than={{ dr_retention_days }}d --wait --yes
TimeoutStartSec=4h

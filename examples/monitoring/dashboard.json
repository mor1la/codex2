      "datasource": {
        "type": "prometheus",
        "uid": "mongo-dr-prometheus"
      },
      "targets": [
        {
          "expr": "100 * (1 - avg by(host) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))",
          "refId": "A",
          "legendFormat": "{{host}}"
        }
      ],
      "gridPos": {
        "x": 16,
        "y": 21,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
